   "source": [
    "window_size :int = int(input())\n",
    "\n",
    "lst = [1,2,3,4,5,6,7,8,9,0]\n",
    "\n",
    "def window(lst :list, window_size :int):\n",
    "    new_list = []\n",
    "    for i in range(0, len(lst)-window_size+1):\n",
    "        new_list.append(tuple(lst[i:i+window_size]))\n",
    "    return new_list\n",
    "\n",
    "print(window(lst, window_size))"
   ]
  }
