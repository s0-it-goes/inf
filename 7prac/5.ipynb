    "nums :list= [12, -5, 0, 7, 18, -3, 9, 24, 6, 15]\n",
    "\n",
    "even :list = list(filter(lambda n: n % 2 == 0, nums))\n",
    "positive :list = list(filter(lambda n: n > 0, nums))\n",
    "num :list = list(filter(lambda n: n % 3 == 0 and n > 5, nums))\n",
    "print(even, positive, num, sep = '\\n')"
   ]
  }
